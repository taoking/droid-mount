+		//! One GetPartialObject transaction costs ~1.5 ms on top of its payload, so a reader
+		//! that streams a file gets one large fetch instead of one per FUSE request. A few
+		//! buffers keep interleaved readers (two copies, or a copy and a thumbnail) from
+		//! discarding each other's data.
+		struct ReadAheadEntry
+		{
+			FuseId			Inode;
+			off_t			Offset;
+			mtp::ByteArray	Data;
+		};
+		std::list<ReadAheadEntry>					_readAhead;
+		static constexpr size_t						ReadAheadEntries = 3;
+		static constexpr off_t						ReadAheadMaxSize = 8 * 1024 * 1024;
+		//! A sequential reader asking for this much at a time (cp and Finder read 1 MiB at
+		//! a time) goes straight to the largest fetch; smaller requests double theirs.
+		static constexpr off_t						ReadAheadLargeRequest = 512 * 1024;
+
+		//! Finder, the Storage settings pane and copyfile poll statfs constantly, and each
+		//! call used to cost one GetStorageInfo transaction per storage.
+		struct CachedStorageInfo
+		{
+			mtp::msg::StorageInfo	Info;
+			time_t					Fetched;
+		};
+		std::map<mtp::StorageId, CachedStorageInfo>	_storageInfoCache;
+		static constexpr time_t						StorageInfoTtl = 5;
