+		//! The first read of a file and every seek fetch just what was asked for, so reading
+		//! the head of a photo or seeking in a video does not pull in megabytes nobody reads.
+		//! The fetch only grows for a reader that continues where the last one ended.
+		mtp::ByteArray ReadAhead(FuseId inode, mtp::ObjectId objectId, off_t objectSize, off_t begin, off_t size)
+		{
+			off_t fetch = size;
+			auto it = std::find_if(_readAhead.begin(), _readAhead.end(), [inode](const ReadAheadEntry & e) { return e.Inode == inode; });
+			if (it != _readAhead.end())
+			{
+				off_t end = it->Offset + static_cast<off_t>(it->Data.size());
+				if (begin >= it->Offset && begin + size <= end)
+				{
+					auto src = it->Data.data() + (begin - it->Offset);
+					mtp::ByteArray data(src, src + size);
+					_readAhead.splice(_readAhead.begin(), _readAhead, it);
+					return data;
+				}
+				if (begin == end)
+				{
+					if (size >= ReadAheadLargeRequest)
+						fetch = ReadAheadMaxSize;
+					else
+						fetch = 2 * static_cast<off_t>(it->Data.size());
+				}
+				_readAhead.erase(it);
+			}
+			if (fetch > ReadAheadMaxSize)
+				fetch = ReadAheadMaxSize;
+			fetch = std::max<off_t>(size, std::min<off_t>(fetch, objectSize - begin));
+
+			mtp::ByteArray fetched = _session->GetPartialObject(objectId, begin, fetch);
+			mtp::ByteArray data(fetched.begin(), fetched.begin() + std::min<off_t>(size, fetched.size()));
+			_readAhead.push_front(ReadAheadEntry{inode, begin, std::move(fetched)});
+			if (_readAhead.size() > ReadAheadEntries)
+				_readAhead.pop_back();
+			return data;
 		}
 
+		void DropReadAhead(FuseId inode)
+		{ _readAhead.remove_if([inode](const ReadAheadEntry & e) { return e.Inode == inode; }); }
+
+		mtp::msg::StorageInfo GetCachedStorageInfo(mtp::StorageId storageId)
+		{
+			time_t now = time(NULL);
+			auto it = _storageInfoCache.find(storageId);
+			if (it != _storageInfoCache.end() && now - it->second.Fetched < StorageInfoTtl)
+				return it->second.Info;
+			auto info = _session->GetStorageInfo(storageId);
+			_storageInfoCache[storageId] = CachedStorageInfo{info, now};
+			return info;
+		}
